# The host app (priv_app) talks to hermessimd (started by service.sh, domain magisk) over @hermessimd.
allow priv_app magisk unix_stream_socket { connectto read write getattr }
# The audio socket (@hermessimd-audio) is SOCK_SEQPACKET.
allow priv_app magisk unix_seqpacket_socket { connectto read write getattr getopt setopt }
